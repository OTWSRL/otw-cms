{
  "name": "otw-cms",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --filter @otwdesign/web dev",
    "build": "pnpm --filter @otwdesign/web build",
    "seed": "pnpm --filter @otwdesign/web seed",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run --testTimeout=15000",
    "test:watch": "vitest --testTimeout=15000",
    "test:e2e": "pnpm --filter @otwdesign/web test:e2e",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-core-version.mjs",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.3",
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
