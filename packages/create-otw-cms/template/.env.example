# Postgres for production: on Supabase or Neon, its pooler's connection string. Leave unset to
# use the embedded PGlite database in CMS_DATA_DIR.
DATABASE_URL=
CMS_DATA_DIR=.data/pglite

# The media library's files, on this server's disk unless a plugin stores them elsewhere, and
# the largest file one upload may be, in megabytes (64 by default).
CMS_UPLOADS_DIR=.data/uploads
CMS_MAX_UPLOAD_MB=

# When database migrations run: "startup" (default) when the site starts, for one server;
# "deploy" never at runtime: run `cms migrate` when you deploy (several instances, serverless).
CMS_MIGRATIONS=

# Set to 1 behind a reverse proxy you run (nginx, Caddy) that sends X-Forwarded-Host and
# X-Forwarded-Proto, so admin forms see the address visitors use. cms serve sets it itself.
CMS_TRUST_PROXY=

# Signs admin flash messages. Leave unset to use a random secret stored in the database.
CMS_SECRET=

# Comma-separated plugin ids. Setting it pins the active plugins and turns off activation in
# the admin. Leave unset to manage plugins in the admin (everything starts active).
CMS_ACTIVE_PLUGINS=

# Public origin, used for links sent elsewhere (payment return pages) behind proxies.
SITE_URL=
SITE_LOCALE=

# Updates from the admin on a site that builds from git: the repository (owner/name) and a token
# that may run its workflows (a fine-grained token with Actions: read and write). The update
# workflow, .github/workflows/cms-update.yml, opens a pull request. On your own server, run the
# site with `cms serve` instead, and leave these empty.
CMS_GITHUB_REPO=
CMS_GITHUB_TOKEN=

# Where nothing runs between requests (Vercel and other serverless hosts), a scheduled request to
# /api/p/core/cron runs the site's due jobs: scheduled posts, emptying the Trash, plugins' work.
# It must carry this secret, as `Authorization: Bearer <secret>`; Vercel's cron sends it by
# itself. At least 16 random letters and digits. Without it the address answers 404. A server
# that keeps running (cms serve, Docker) runs its jobs itself and doesn't need it.
CRON_SECRET=

# Plugins list the variables they read in their own documentation.
