      "types": "./config.d.ts",
      "default": "./config.js"
    },
    "./server": "./src/server.ts",
    "./site": "./src/site/index.ts",
    "./tracing": "./src/tracing.ts",
    "./uploads": "./src/uploads.ts",
    "./instrumentation": "./src/instrumentation.ts"
  },
  "files": [
    "src",
    "config.js",
    "config.d.ts",
    "NOTICE"
