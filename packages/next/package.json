  "dependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@opentelemetry/api": "~1.9.0",
    "@opentelemetry/sdk-trace": "^2.12.0",
    "@otwdesign/admin-ui": "workspace:*",
    "@otwdesign/core": "workspace:*",
    "@otwdesign/sdk": "workspace:*",
    "@tiptap/core": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@types/pg": "^8.23.1",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "server-only": "^0.0.1"
  },
  "peerDependencies": {
    "next": "^16.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "happy-dom": "^21.0.4",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
