{
  "name": "@otwdesign/next",
  "version": "1.0.1",
  "description": "OTW CMS on Next.js: the admin, the site's pages, the plugin API routes, uploads, and withCms() for next.config.",
  "license": "Apache-2.0",
  "author": "OTW SRL",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OTWSRL/otw-cms.git",
    "directory": "packages/next"
  },
  "homepage": "https://github.com/OTWSRL/otw-cms/tree/main/packages/next#readme",
  "bugs": {
    "url": "https://github.com/OTWSRL/otw-cms/issues"
  },
  "keywords": [
    "otw-cms",
    "cms",
    "nextjs",
    "react"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./admin": "./src/admin/index.ts",
    "./api": "./src/api.ts",
