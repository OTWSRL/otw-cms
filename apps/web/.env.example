# Postgres for production. Leave unset to use the embedded PGlite database in CMS_DATA_DIR.
DATABASE_URL=
CMS_DATA_DIR=.data/pglite

# The media library's files, on this server's disk unless a plugin stores them elsewhere, and
# the largest file one upload may be, in megabytes (64 by default).
CMS_UPLOADS_DIR=.data/uploads
CMS_MAX_UPLOAD_MB=

# When database migrations run: "startup" (default) when the site starts, for one server;
# "deploy" never at runtime: run `cms migrate` when you deploy (several instances, serverless).
CMS_MIGRATIONS=

# Set to 1 behind a reverse proxy you run (nginx, Caddy) that sends X-Forwarded-Host and
# X-Forwarded-Proto, so admin forms see the address visitors use. cms serve sets it itself.
CMS_TRUST_PROXY=

# Signs admin flash messages. Leave unset to use a random secret stored in the database.
CMS_SECRET=

# Comma-separated plugin ids. Setting it pins the active plugins and turns off activation in
# the admin. Leave unset to manage plugins in the admin (everything starts active).
CMS_ACTIVE_PLUGINS=

# Settings below can also be changed in the admin; a value set here wins and shows read-only.
# Public origin, used for payment return URLs behind proxies.
SITE_URL=
SITE_LOCALE=

COMMERCE_CURRENCY=

# Secrets are read from the environment only. Card payments are disabled until both are set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
